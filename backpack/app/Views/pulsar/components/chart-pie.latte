/*
    $data array contains the values and labels for the pie.

    ATTRIBUTES:
    . graph-id=null (autogenerated)
    . graph-colors=null['#ddecdd']
*/
{define "zf-chart-pie", array $data, array $attributes = []}
    {varType string $nonce}
    {var string $graphIdentifier = $attributes['graph-id'] ?? uniqid("graph-")}
    {var array $graphColors = $attributes['graph-colors'] ?? ['#ddecdd']}
    {var array $graphData = array_values($data)}
    {var array $graphLabels = array_keys($data)}
    <div id="{$graphIdentifier}"></div>
    <script n:if="$graphData" nonce={$nonce}>
        new ApexCharts(document.getElementById({$graphIdentifier}), {
            series: {$graphData},
            chart: {
                width: '100%',
                height: '100%',
                type: 'pie',
            },
            labels: {$graphLabels},
            theme: {
                monochrome: {
                    enabled: true,
                },
            },
            legend: {
                show: false,
            },
            colors: {$graphColors}
        }).render();
    </script>
{/define}
