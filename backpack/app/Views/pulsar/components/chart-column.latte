/*
    $series array contains a list of objects as follows.

    {
        name: 'Net Profit',
        data: [44, 55, 57, 56, 61, 58, 63, 60, 66]
    }

    ATTRIBUTES:
    . graph-id=null (autogenerated)
    . graph-colors=null['#ddecdd']
*/
{define "zf-chart-column", array $series, array $labels, array $attributes = []}
    {varType string $nonce}
    {var string $graphIdentifier = $attributes['graph-id'] ?? uniqid("graph-")}
    {var array $graphColors = $attributes['graph-colors'] ?? ['#ddecdd']}
    <div id="{$graphIdentifier}"></div>
    <script n:if="$series" nonce={$nonce}>
        new ApexCharts(document.getElementById({$graphIdentifier}), {
            series: {$series},
            chart: {
                width: '100%',
                height: '100%',
                type: 'bar',
            },
            plotOptions: {
                bar: {
                    horizontal: false,
                    columnWidth: '55%',
                    borderRadius: 5,
                    borderRadiusApplication: 'end'
                },
            },
            xaxis: {
                categories: {$labels},
            },
            dataLabels: {
                enabled: false
            },
            stroke: {
                show: true,
                width: 2,
                colors: ['transparent']
            },
            legend: {
                show: false,
            },
            colors: {$graphColors}
        }).render();
    </script>
{/define}
